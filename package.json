{
  "name": "terminal",
  "version": "1.1.0",
  "type": "module",
  "description": "A modern terminal emulator with split panes and built-in git tools, built with Electron",
  "main": "main.js",
  "desktopName": "plumterm.desktop",
  "scripts": {
    "build": "cd client && vite build && cd .. && node scripts/bundle.mjs",
    "test": "node tests/terminal.test.js && node tests/queue.test.js",
    "prestart": "npm run build",
    "start": "electron .",
    "postinstall": "electron-rebuild -f -w node-pty",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dev:client": "cd client && vite",
    "dev:server": "node --watch server/index.js",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\" \"npm run dev:electron\"",
    "dev:electron": "VITE_DEV=true electron .",
    "install-app": "chmod +x install-local.sh && ./install-local.sh",
    "dist": "npm run build && electron-builder build --mac --arm64 --x64",
    "package-app": "./package-app.sh"
  },
  "build": {
    "appId": "com.pluminate.plumterm",
    "productName": "PlumTerm",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "client/preload.js",
      "client/dist/**/*",
      "package.json",
      "install.sh"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "type": "distribution",
      "extendInfo": {
        "NSServices": [
          {
            "NSMenuItem": {
              "default": "Open in PlumTerm"
            },
            "NSMessage": "openFile",
            "NSSendFileTypes": [
              "public.folder"
            ]
          }
        ]
      }
    },
    "deb": {
      "packageName": "plumterm",
      "artifactName": "plumterm_${version}_${arch}.deb"
    },
    "linux": {
      "target": [
        "snap",
        "dir"
      ],
      "executableName": "plumterm",
      "category": "Development;System;TerminalEmulator",
      "icon": "build/icon.png",
      "synopsis": "Terminal emulator with split panes and git tools",
      "description": "A modern terminal emulator with split panes and built-in git tools, built with Electron"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "snap": {
      "confinement": "classic",
      "grade": "stable",
      "summary": "Terminal emulator with split panes and git tools",
      "allowNativeWayland": true
    },
    "extraMetadata": {
      "main": "out/main.js"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    }
  },
  "author": {
    "name": "Pluminate",
    "email": "plumterm@pluminate.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "electron": "^31.7.7",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "esbuild": "^0.25.12",
    "playwright": "^1.63.0",
    "vite": "^5.0.12"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.9.0",
    "@xterm/addon-search": "^0.14.0",
    "@xterm/xterm": "^5.4.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "find-up": "^8.0.0",
    "fs-extra": "^11.3.4",
    "isomorphic-git": "^1.37.4",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.0.62",
    "ws": "^8.21.3"
  },
  "homepage": "https://github.com/pluminate/plumterm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pluminate/plumterm.git"
  }
}
